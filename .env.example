# Pick one provider (or pass --llm on the command line)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# Override model names if a provider renames them:
# LLM_MODEL=gemini-2.5-flash
# LLM_VISION_MODEL=gemini-2.5-flash

# Or any OpenAI-compatible endpoint:
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
